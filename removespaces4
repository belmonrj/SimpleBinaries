#!/usr/bin/env perl

use strict;
use warnings;
use utf8;
use open qw(:std :utf8);
use File::Find;
use Encode qw(decode encode);
use Getopt::Long;

# Parse command-line options
my $dry_run = 0;
GetOptions("dry-run" => \$dry_run);

# Directory to scan
my $target_dir = "$ENV{HOME}/Desktop";

# Unicode whitespace pattern
my $whitespace_pattern = qr/\p{Space}/;

# Recurse through directory
find(\&process_file, $target_dir);

sub process_file {
    return if -d $_;  # Skip directories

    my $raw_path = $File::Find::name;
    my $decoded_path = decode('UTF-8', $raw_path);

    if ($decoded_path =~ $whitespace_pattern) {
        my $new_decoded_path = $decoded_path;
        $new_decoded_path =~ s/$whitespace_pattern/_/g;

        print "Found: $decoded_path\n";
        print "  → Would rename to: $new_decoded_path\n";

        unless ($dry_run) {
            my $old = encode('UTF-8', $decoded_path);
            my $new = encode('UTF-8', $new_decoded_path);

            if (rename($old, $new)) {
                print "  ✅ Renamed\n";
            } else {
                warn "  ❌ Failed to rename '$decoded_path': $!";
            }
        }
    }
}

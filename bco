#!/bin/bash

#echo "Name of the script: $0"
#echo "Total number of arguments: $#"
#echo "Values of all the arguments: $@"

D=$(gdate +%s)

if [ $# -eq 1 ]; then
  D=$(gdate +%s --date="$1")

elif [ $# -eq 2 ]; then
  echo "Incorrect usage"
  echo "Do $0 or $0 \"some date\""
  exit 1
fi

S=1672549200

B=$(echo "scale=0; ($D - $S) * 56299000/6" | bc -lq)

R=$(gdate --date=@$D)

echo "HRD is $R"
echo "TSE is $D"
echo "BCO is $B"


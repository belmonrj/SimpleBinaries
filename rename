#!/usr/bin/perl

use strict;
use warnings;

use File::Basename;


### I think this doesn't work correctly if you try to include directories in the name
### I'll try to add that functionality next


my ($old, $new, $start) = @ARGV;

my $narg = $#ARGV+1;

print "Old pattern is $old and new pattern is $new\n";

if ( $narg == 2 )
{
    print "No initial value given, starting with zero\n";
    $start = 0;
}
elsif ( $narg == 3 )
{
    print "Starting with given initial value of $start \n";
}
else
{
    print "Incorrect number of arguments $#ARGV, now dying\n";
    die;
}

# glob is really lovely, check out https://perldoc.perl.org/functions/glob
my @LIST = glob("$old\*");

my $size = @LIST;
my $zero = length($size);


# I guess this doesn't *really* need to be its own variable...
my $index = 0;
if ( $start >= 0 )
{
    $index = $start;
}


# loop over the list of files generated by the glob function
foreach(@LIST)
{
    my $file = $_;
    chomp($file);

    # determine file extension on the fly
    # from the Perl cookbook: https://docstore.mik.ua/orelly/perl4/cook/ch09_11.htm
    # my ($base, $dir, $ext) = fileparse($file,'\..*'); # first period
    my ($base, $dir, $ext) = fileparse($file,'\.[^.]*'); # final period
    #print "From filename $file: base is $base, dir is $dir, and ext is $ext \n";

    # determine the new name from the given string, the zero padding, the starting index, and the file extension
    # note that the file extension includes the dot, so we don't need to add one here
    my $newfile = sprintf("%s_%0*d%s",$new,$zero,$index,$ext);
    print "Old name is $file, new name is $newfile \n";
    # don't overwrite existing files
    die "Refusing to overwrite existing file $newfile, check your starting index and try again\n" if -e $newfile;

    # change the name and increment the index
    system("mv $file $newfile");
    $index++;
}


if ( $size == 1 )
{
    print "1 file changed \n";
}
else
{
    print "$size files changed \n";
}


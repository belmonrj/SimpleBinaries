#!/bin/bash

flag=true

trap "echo Stopping!; exit 0" SIGINT
trap "echo Dying!; exit 0" SIGTERM

catch_sigusr1()
{
  echo "Stopping in a clever way!"
  flag=false
}
catch_sigusr2()
{
  echo "Hey that tickles! Gonna keep going"
}

trap catch_sigusr1 SIGUSR1
trap catch_sigusr2 SIGUSR2

echo "Script started (PID: $$). Press Ctrl+C or send SIGTERM to stop."
while $flag; do
  echo "Working..."
  sleep 2
done

#!/usr/bin/env perl

use strict;
use warnings;
use utf8;
use open qw(:std :utf8);  # Ensure STDIN/STDOUT/STDERR use UTF-8
#use open ':std';  # Ensure STDIN/STDOUT/STDERR use UTF-8
#use open ':utf8';  # Ensure STDIN/STDOUT/STDERR use UTF-8
use File::Find;
use Encode qw(decode encode);
#use Encode 'decode';
#use Encode 'encode';

# Directory to scan (you can change this!)
my $target_dir = "$ENV{HOME}/Desktop";

# Unicode whitespace matcher: \p{Space} matches all space separators
my $whitespace_pattern = qr/\p{Space}/;

# Recurse through files
find(\&process_file, $target_dir);

sub process_file {
    return if -d $_;  # Skip directories

    # Full path as raw bytes from the filesystem
    my $raw_path = $File::Find::name;

    # Decode to Perl's internal Unicode representation
    my $decoded_path = decode('UTF-8', $raw_path);

    # Only rename if it contains any Unicode whitespace
    if ($decoded_path =~ $whitespace_pattern) {
        my $new_decoded_path = $decoded_path;
        $new_decoded_path =~ s/$whitespace_pattern/_/g;

        # Re-encode to byte string for use with rename()
        my $old = encode('UTF-8', $decoded_path);
        my $new = encode('UTF-8', $new_decoded_path);

        # Rename and report
        if (rename($old, $new)) {
            print "Renamed:\n  $decoded_path\n  → $new_decoded_path\n";
        } else {
            warn "Failed to rename '$decoded_path': $!";
        }
    }
}

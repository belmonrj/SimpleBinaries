#!/bin/bash

# check if gdate is available
# if it is, use it, otherwise use date
# date works fine if it's GNU date, but BSD date may not work
if command -v gdate >/dev/null 2>&1; then
  DATE_CMD="gdate"
else
  DATE_CMD="date"
fi


# initalize some variables
SINCE_DATE=""
UNTIL_DATE=""
DIFFERENCE_STRING=""
DIFFERENCE=0

# use current date as default
NOW=$($DATE_CMD +%s)
SINCE=$NOW
UNTIL=$NOW

# calculate the difference in seconds based on until and since
calculate_difference()
{
  DIFFERENCE=$(($UNTIL-$SINCE))
}

# determine the difference string based on the difference in seconds
determine_difference_string()
{
  # put code here to convert difference into something nice
  DAYS=$(($DIFFERENCE/86400))
  PART=$(($DIFFERENCE%86400))
  HOURS=$((PART/3600))
  PART=$((PART%3600))
  MINUTES=$((PART/60))
  SECONDS=$(($PART%60))

  # now make the difference string to make it nice and readable
  # less than a minute
  if [ "$DIFFERENCE" -lt 60 ]; then
    DIFFERENCE_STRING="$SECONDS second"
    if [ "$SECONDS" -ne 1 ]; then
      DIFFERENCE_STRING+="s"
    fi
  # less than an hour
  elif [ "$DIFFERENCE" -lt 3600 ]; then
    DIFFERENCE_STRING="$MINUTES minute"
    if [ "$MINUTES" -ne 1 ]; then
      DIFFERENCE_STRING+="s"
    fi
    DIFFERENCE_STRING+=", and $SECONDS second"
    if [ "$SECONDS" -ne 1 ]; then
      DIFFERENCE_STRING+="s"
    fi
  # less than a day
  elif [ "$DIFFERENCE" -lt 86400 ]; then
    DIFFERENCE_STRING="$HOURS hour"
    if [ "$HOURS" -ne 1 ]; then
      DIFFERENCE_STRING+="s"
    fi
    DIFFERENCE_STRING+=", $MINUTES minute"
    if [ "$MINUTES" -ne 1 ]; then
      DIFFERENCE_STRING+="s"
    fi
    DIFFERENCE_STRING+=", and $SECONDS second"
    if [ "$SECONDS" -ne 1 ]; then
       DIFFERENCE_STRING+="s"
    fi
  # more than a day
  else
    DIFFERENCE_STRING="$DAYS day"
    if [ "$DAYS" -ne 1 ]; then
      DIFFERENCE_STRING+="s"
    fi
    DIFFERENCE_STRING+=", $HOURS hour"
    if [ "$HOURS" -ne 1 ]; then
      DIFFERENCE_STRING+="s"
    fi
    DIFFERENCE_STRING+=", $MINUTES minute"
    if [ "$MINUTES" -ne 1 ]; then
      DIFFERENCE_STRING+="s"
    fi
    DIFFERENCE_STRING+=", and $SECONDS second"
    if [ "$SECONDS" -ne 1 ]; then
      DIFFERENCE_STRING+="s"
    fi
  fi
} # determine_difference_string


# print the difference string to the screen
print_difference()
{
  # now print all that stuff to the screen
  if [[ $SINCE -ne $NOW && $UNTIL -eq $NOW ]]; then
    echo "It has been $DIFFERENCE_STRING since $SINCE_DATE"
  elif [[ $SINCE -eq $NOW && $UNTIL -ne $NOW ]]; then
    echo "It is $DIFFERENCE_STRING until $UNTIL_DATE"
  elif [[ $SINCE -ne $NOW && $UNTIL -ne $NOW ]]; then
    echo "The time difference between $SINCE_DATE and $UNTIL_DATE is $DIFFERENCE_STRING"
  else
    echo "Unknown condition"
  fi
}

MULTIPLIER=1
UNIT="second"

# loop over the arguments once to check all for --UNITS
# use that information to set the multiplier and unit
# do this first so that --UNITS can come before or after --ago or --from_now
for arg in "$@"; do
  case "$arg" in
    --days)
      MULTIPLIER=86400
      UNIT="day"
      ;;
    --hours)
      MULTIPLIER=3600
      UNIT="hour"
      ;;
    --minutes)
      MULTIPLIER=60
      UNIT="minute"
      ;;
  esac
done

# loop over the arguments a second time to check for other options
# case seems to be the most elegant solution for setting the options
for arg in "$@"; do
  case "$arg" in
    --since=*)
      SINCE_DATE="${arg#--since=}"
      # update the since date string with the default format of DATE_CMD
      SINCE_DATE=$($DATE_CMD --date="$SINCE_DATE")
      SINCE=$($DATE_CMD +%s --date="$SINCE_DATE")
      # calculate the difference with the function
      calculate_difference
      # determine the difference string
      determine_difference_string
      # print the string to the screen
      print_difference
      ;;
    --until=*)
      UNTIL_DATE="${arg#--until=}"
      # update the until date string with the default format of DATE_CMD
      UNTIL_DATE=$($DATE_CMD --date="$UNTIL_DATE")
      UNTIL=$($DATE_CMD +%s --date="$UNTIL_DATE")
      # calculate the difference with the function
      calculate_difference
      # determine the difference string
      determine_difference_string
      # print the string to the screen
      print_difference
      ;;
    --ago=*)
      AGO_REL="${arg#--ago=}"
      if [ $AGO_REL -gt 1 ]; then
        UNIT+="s"
      fi
      AGO_REL_MULT=$(($AGO_REL*MULTIPLIER))
      AGO_ABS=$(($NOW-$AGO_REL_MULT))
      AGO_DATE=$($DATE_CMD --date=@$AGO_ABS)
      echo "The date $AGO_REL $UNIT ago was $AGO_DATE"
      exit 0
      ;;
    --from_now=*)
      FN_REL="${arg#--from_now=}"
      if [ $FN_REL -gt 1 ]; then
        UNIT+="s"
      fi
      FN_REL_MULT=$(($FN_REL*MULTIPLIER))
      FN_ABS=$(($NOW+$FN_REL_MULT))
      FN_DATE=$($DATE_CMD --date=@$FN_ABS)
      echo "The date $FN_REL $UNIT from now will be $FN_DATE"
      exit 0
      ;;
    --help|-h)
      echo "Usage: $0 [--since=\"DATE\"] [--until=\"DATE\"]"
      exit 0
      ;;
    --days)
      ;;
    --hours)
      ;;
    --minutes)
      ;;
    *)
      echo "Unknown option: $arg"
      echo "Run with --help for usage."
      exit 1
      ;;
  esac
done



#!/usr/bin/perl

use Getopt::Long;

@go_up;
@come_down;
$debug = 0;

GetOptions('d|down=s{1,}' => \@come_down, 'u|up=s{1,}' => \@go_up, 'debug' => \$debug);

####################################

$prefix_string = "sftp belmonrj@sftp.sdcc.bnl.gov <<EOF\n";

####################################

$up_string = '';

foreach $up_file (@go_up)
{
    chomp($up_file);
    $up_string.="put ".$up_file."\n";
}

print "up string is ".$up_string."\n";

####################################

$down_string = '';

foreach $down_file (@come_down)
{
    chomp($down_file);
    $down_string.="get ".$down_file."\n";
}

####################################

$suffix_string = "EOF";

$command_string = $prefix_string.$up_string.$down_string.$suffix_string;

if ( $debug )
{
    print "The final string is ".$command_string."\n";
}
else
{
    system($command_string);
}


#!/usr/bin/perl

use Getopt::Long;

$go_up = 0;
$come_down = 0;

GetOptions('d|down=s' => \$come_down, 'u|up=s' => \$go_up);

####################################

$prefix_string = 'sftp belmonrj@sftp.sdcc.bnl.gov:';

####################################

if ( $go_up && !$come_down )
{
    $input_string = $go_up;
    $command_string = $prefix_string.' <<< $\'put '.$input_string.'\'';
    print "Command string is $command_string \n\n";
    system($command_string);
}

####################################

if ( $come_down && !$go_up )
{
    $input_string = $come_down;
    $command_string = $prefix_string.$input_string.' .';
    print "Command string is $command_string \n\n";
    system($command_string);
}

